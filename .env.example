# Run python3 tools/init-env.py to create .env with a random database password.
BIND_ADDRESS=127.0.0.1
PORT=8080
POSTGRES_DB=dirtbound
POSTGRES_USER=dirtbound
POSTGRES_PASSWORD=replace-with-random-password
# DIRTBOUND_IMAGE=dirtbound-go:local

# Generated by tools/init-env.py. Grants permanent beta access after redemption.
BETA_TESTER_CODE=generate-on-init
